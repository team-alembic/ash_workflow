#!/usr/bin/env bash
# Regenerates the chart examples in documentation/topics/*.md from the
# workflows in examples/. See AshWorkflowTest.ChartExamples for the markers.
# The SVGs under documentation/topics/assets/ need the dot command of
# Graphviz and the d2 binary, which the script downloads when it is not
# there. Without dot, or when the d2 download fails, the script fails and
# changes no file.
# The examples compile only in the test environment, hence MIX_ENV=test.
set -euo pipefail

cd "$(dirname "$0")/.."

MIX_ENV=test mix run --no-start -e '
case AshWorkflowTest.ChartExamples.update!() do
  [] -> IO.puts("Chart examples are up to date.")
  files -> Enum.each(files, &IO.puts("Updated #{&1}"))
end
'
